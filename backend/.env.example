# ---- Sardine API credentials (sandbox) ----
# Your backend uses these to call Sardine and mint the SDK session token.
# NEVER expose these to the browser. Copy this file to `.env` and fill in.
SARDINE_CLIENT_ID=
SARDINE_SECRET_KEY=

# Sardine API base URL.
#   Sandbox:    https://api.sandbox.sardine.ai
#   Production:  https://api.sardine.ai
SARDINE_API_URL=https://api.sandbox.sardine.ai

# Webhook signing secret (provided by your Sardine team).
# Used to verify that incoming document_verification.processed events are genuine.
SARDINE_WEBHOOK_SECRET=your-webhook-signing-secret

# Port the backend listens on (frontend points VITE_BACKEND_URL here).
PORT=8080

# Where every Sardine customer-API (/v1/customers, /v1/feedbacks) call and
# every incoming webhook gets appended as JSON lines, for replaying/inspecting
# a full interaction later. Defaults to backend/logs/sardine-interactions.log
# (gitignored via *.log — these can contain PII).
INTERACTION_LOG_FILE=

# Optional demo fallbacks for POST /verify-token when called without a
# sessionKey/onboardingId (e.g. hitting it directly for debugging). In the
# real flow these come from /onboard — see the two-step onboarding note
# at the top of server.js.
DEMO_SESSION_KEY=
DEMO_ONBOARDING_ID=
