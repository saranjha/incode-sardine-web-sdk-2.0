# Copy to `.env`. Vite only exposes vars prefixed with VITE_.

# Leave BLANK to call the backend same-origin ("/verify-token") via the Vite
# proxy (see vite.config.js). This is REQUIRED for phone testing through ngrok —
# an absolute http://localhost:8080 would resolve to the phone, not your machine.
# Only set this if you host the backend at a separate absolute URL.
VITE_BACKEND_URL=

# Public HTTPS URL of your dev server when tunneling (ngrok). The QR encodes this
# so the phone loads the page over HTTPS (required for the camera). Example:
#   VITE_PUBLIC_URL=https://abc123.ngrok-free.app
# Leave blank for plain localhost dev (no phone camera).
VITE_PUBLIC_URL=

# Where the backend actually runs (the Vite proxy forwards to this). Default is
# http://localhost:8080 — only change if your Express server uses another port.
VITE_BACKEND_PROXY_TARGET=http://localhost:8080

# Incode API URL for your environment. It must end in /0 — the /0 suffix lets
# Incode read the API key from the Sardine-issued session token (without it the
# SDK gets HTTP 403). A trailing slash is normalized away.
#   Sandbox:     https://demo-api.incodesmile.com/0
#   Production:  https://saas-api.incodesmile.com/0
VITE_INCODE_API_URL=https://demo-api.incodesmile.com/0

# consentId provided by your Sardine team (drives the data-sharing consent screen).
VITE_CONSENT_ID=PROVIDED_BY_SARDINE

# Phase 2 hook: which program's branding to render (sardine | bilt | coinbase).
# Phase 1 only ships 'sardine'; see src/style.css.
VITE_BRAND_PROGRAM=sardine
